# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL)
# When running with Docker or local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointment_db
# Or individual parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointment_db
DB_USER=postgres
DB_PASSWORD=postgres

# Notification Service (mock or aws)
NOTIFICATION_PROVIDER=mock

# AWS Configuration (Placeholder for Phase 12 - AWS Deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:appointment-reminders
AWS_SES_SENDER_EMAIL=noreply@appointment-platform.com

# Automation Scheduler Settings (minutes)
REMINDER_CHECK_INTERVAL_MINUTES=5
