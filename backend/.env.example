# ==============================================================================
# SMART APPOINTMENT OPTIMIZATION & NO-SHOW PREVENTION PLATFORM
# Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# JWT Authentication Secret (Use strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_for_development
JWT_EXPIRES_IN=24h

# ==============================================================================
# DATABASE CONFIGURATION: AMAZON RDS (POSTGRESQL) & LOCAL DUAL-MODE
# ==============================================================================
# NOTE: If DB connection fails or is left default, the platform automatically
# activates the resilient in-memory transactional store for zero-setup local use.
#
# OPTION A: Full Connection String (Recommended for Amazon RDS)
# Replace <RDS_PASSWORD> and <RDS_ENDPOINT> with values from your AWS Console:
# DATABASE_URL=postgresql://postgres:YourSecurePassword123!@appointment-rds-db.c9xxxxxxx.us-east-1.rds.amazonaws.com:5432/appointment_db
DATABASE_URL=

# OPTION B: Discrete Amazon RDS Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointment_db
DB_USER=postgres
DB_PASSWORD=postgres

# RDS SSL & Connection Options
# Set DB_SSL=true when connecting to AWS RDS instances to enforce encrypted transit
DB_SSL=false
# Initial connection timeout in milliseconds (Recommended 10000 for AWS RDS across WAN)
DB_TIMEOUT_MS=5000

# ==============================================================================
# NOTIFICATION ENGINE PROVIDER
# ==============================================================================
# Values: 'mock' (default, safe for local testing & viva demo) or 'aws' (Amazon SNS/SES)
NOTIFICATION_PROVIDER=mock

# Automation Scheduler Settings (minutes between automated reminder scans)
REMINDER_CHECK_INTERVAL_MINUTES=5

# ==============================================================================
# AWS SERVICES CONFIGURATION (OPTIONAL / PRODUCTION)
# ==============================================================================
# Required only if NOTIFICATION_PROVIDER is set to 'aws' or using AWS SDK directly
AWS_REGION=us-east-1
# DO NOT COMMIT REAL CREDENTIALS. Store only in your local backend/.env file:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:appointment-reminders
AWS_SES_SENDER_EMAIL=noreply@appointment-platform.com
